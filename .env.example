# locust — copy to .env; every variable is optional.
PORT=4070

# Bind address of the swarm API.
HOST=0.0.0.0

# 1 = silence per-request access logs.
SWARM_QUIET_LOGS=0

# Default target for locustfile.py / the CI smoke (empty = local mock target).
TARGET_HOST=

# Hosts `mode: live_probe` may target (comma-separated, exact hostname match).
# Empty = the portfolio's public globlex.* / perfops.* hosts.
SWARM_ALLOWED_TARGET_HOSTS=
